# Environment variables template for OSIS MPK Attendance System
# Copy this file to .env and configure with your local development database credentials.

# PostgreSQL Connection URL
DATABASE_URL="postgresql://user:password@localhost:5432/osis_mpk_attendance?schema=public"

# Application Environment
NODE_ENV="development"

# Authentication Session Secret (Minimal 32 karakter untuk enkripsi HS256)
AUTH_SECRET="your-secure-random-32-character-secret-key-change-me"

# One-time Superadmin Provisioning Secret (Minimal 16 karakter untuk inisialisasi akun Superadmin perdana)
INITIAL_SUPERADMIN_SECRET="your-secure-random-initial-superadmin-setup-secret-16-chars-min"
